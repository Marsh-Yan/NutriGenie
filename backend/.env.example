# Application
APP_NAME=NutriGenie
APP_VERSION=1.0.0
DEBUG=true

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=nutrigenie
# Optional quick-demo database, for example: sqlite:///./data/nutrigenie.db
DATABASE_URL_OVERRIDE=

# DeepSeek: intent analysis and AI-native plan generation
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=30
PLAN_GENERATION_MODEL=
PLAN_GENERATION_TIMEOUT=60
PLAN_REPAIR_MAX_ATTEMPTS=2
PLAN_PROMPT_VERSION=ai_native_v2
PLAN_CANDIDATE_MIN=12
PLAN_CANDIDATE_MAX=32
PLAN_MAX_RECIPE_REPEAT=2
PLAN_MIN_UNIQUE_RATIO=0.67
PLAN_CALORIE_TOLERANCE=0.15
PLAN_BUDGET_TOLERANCE=0.10
MAX_PLAN_MESSAGE_LENGTH=1000

# Zhipu AI: remote embeddings (Phase 1)
EMBEDDING_PROVIDER=zhipu
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024

# RAG / Chroma
CHROMA_PERSIST_DIR=data/chroma
RAG_RETRIEVAL_TOP_K=30
RAG_CONTEXT_TOP_K=5
RAG_MODE=auto
RAG_VECTOR_WEIGHT=0.7
RAG_KEYWORD_WEIGHT=0.3
RAG_MIN_SIMILARITY=0.15
KNOWLEDGE_QUEUE_BACKEND=background
KNOWLEDGE_REDIS_URL=redis://localhost:6379/0
KNOWLEDGE_MAX_RETRIES=3
KNOWLEDGE_RETRY_BACKOFF_SECONDS=[10,30,60]
KNOWLEDGE_MAX_CONCURRENCY=2

# Authentication (local development only verification code)
JWT_SECRET_KEY=replace-with-a-random-secret-before-deployment
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DEV_EMAIL_VERIFICATION_CODE=123456
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NICKNAME=管理员
